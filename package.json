{
  "name": "xqtime",
  "version": "0.2.1",
  "description": "Friendly relative time labels (刚刚 / 12分钟前 / 3天前) from a Date, a timestamp or a date string.",
  "main": "lib/xqtime.js",
  "types": "index.d.ts",
  "llms": "./llms.txt",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./lib/xqtime-esm.mjs",
      "require": "./lib/xqtime.js",
      "default": "./lib/xqtime.js"
    },
    "./lib/xqtime": "./lib/xqtime.js",
    "./lib/xqtime.min": "./lib/xqtime.min.js",
    "./lib/xqtime-esm": "./lib/xqtime-esm.js",
    "./lib/xqtime-esm.min": "./lib/xqtime-esm.min.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "unpkg": "lib/xqtime.min.js",
  "jsdelivr": "lib/xqtime.min.js",
  "files": [
    "lib",
    "index.d.ts",
    "llms.txt",
    "zh.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=14.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "check:agent-docs": "node scripts/check-agent-metadata.mjs",
    "test": "node scripts/build.mjs --check && node --test test/unit.test.mjs test/artifacts.test.mjs test/pages.test.mjs",
    "test:node": "node test/node.js",
    "test:browser": "node scripts/serve.mjs",
    "prepublishOnly": "npm run check:agent-docs && node scripts/build.mjs --check",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitguanqi/xqtime.git"
  },
  "keywords": [
    "time",
    "date",
    "relative-time",
    "timeago",
    "xqtime"
  ],
  "author": "gitguanqi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gitguanqi/xqtime/issues"
  },
  "homepage": "https://github.com/gitguanqi/xqtime#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  }
}
